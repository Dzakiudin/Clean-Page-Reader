{
  "manifest_version": 3,
  "name": "Clean Page Reader",
  "version": "1.0",
  "description": "Satu klik untuk membersihkan halaman dari iklan, sidebar, dan gangguan lainnya, menampilkan artikel dalam mode baca yang fokus dan minimalis. BY JAKIJEKI",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Bersihkan Halaman Ini"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
